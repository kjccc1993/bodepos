{
  "name": "bodepos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:create-users": "tsx prisma/create-users.ts",
    "prisma:import-catalog": "tsx prisma/import-catalog.ts",
    "prisma:import-merchant-catalog": "tsx prisma/import-merchant-catalog.ts",
    "prisma:sync-products-prod": "tsx prisma/sync-products-to-prod.ts",
    "prisma:assign-categories": "tsx prisma/assign-product-categories.ts",
    "prisma:backfill-opening-invoices": "tsx prisma/backfill-opening-balance-invoices.ts",
    "predev": "prisma generate",
    "dev": "nodemon",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/product-pricing.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "6.19.3",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.3"
  },
  "packageManager": "yarn@4.13.0"
}
